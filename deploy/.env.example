# === Paths (defaults work for Mac Studio) ===
FRONTEND_DIST=/Users/max_server/repo_claude/DS-Online/dist
BACKEND_DIR=/Users/max_server/repo_claude/web_slicer_core
SLICER_ENGINE_BIN=/path/to/web_slicer_core/slicer-engine/bin/slicer-engine
PYTHON_BIN=/opt/homebrew/bin/python3.12
NGINX_BIN=/opt/homebrew/bin/nginx

# === Ports ===
NGINX_PORT=8179
BACKEND_PORT=5179

# === CORS (agent) ===
# Hardcoded: three SlicerGo Dental hosts + https://dsonline.phrozen3d.info
# Add localhost / legacy dev|release dsonline / anything else here (comma-separated).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,https://dev.dsonline.phrozen3d.info,https://release.dsonline.phrozen3d.info

# === Logs ===
LOG_DIR=/Users/max_server/Library/Logs

# === Cloudflare Tunnel ===
# Managed via Cloudflare dashboard (not by these scripts).
# Tunnel: phrozen-dental-slicer -> localhost:${NGINX_PORT}
# URL: https://phrozen-dental-slicer.max-the-lab.dev
