# Agent process env (copy to .env.local or export before scripts/run_agent.*)
#
# Hardcoded CORS allowlist in agent/main.py:
#   https://dev.slicergo-dental.phrozen3d.info
#   https://release.slicergo-dental.phrozen3d.info
#   https://slicergo-dental.phrozen3d.info
#   https://dsonline.phrozen3d.info
# Everything else (localhost, legacy dev/release dsonline, …) must be listed here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173,https://127.0.0.1:5173,https://dev.dsonline.phrozen3d.info,https://release.dsonline.phrozen3d.info

# Optional: point at a local engine build
# SLICER_ENGINE_BIN=

# Optional: custom TLS material (defaults resolve under agent/tls/ or Bundle-Launcher)
# AGENT_TLS_CERTFILE=
# AGENT_TLS_KEYFILE=
